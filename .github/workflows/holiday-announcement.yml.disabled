name: 节日公告自动更新

on:
  schedule:
    # 每天北京时间 00:00 运行（UTC 16:00）
    - cron: '0 16 * * *'
  workflow_dispatch:  # 允许手动触发

permissions:
  contents: write

jobs:
  update-announcement:
    runs-on: ubuntu-latest

    steps:
      - name: 检出仓库
        uses: actions/checkout@v4

      - name: 设置 Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: 更新节日公告
        run: python3 .github/scripts/holiday_announcement.py

      - name: 提交并推送变更
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add index.html
          if ! git diff --cached --quiet; then
            git commit -m "📢 auto: 更新节日公告 $(date +'%Y-%m-%d')"
            git push
            echo "✅ 公告已提交并推送"
          else
            echo "📋 公告无变化，跳过提交"
          fi
