    <script>
document.addEventListener('DOMContentLoaded', function() {
    const currentArticleId = 18;

    function initArticleNavigation(articleId) {
        const navigation = document.getElementById('articleNavigation');
        if (!navigation || typeof window.articlesData === 'undefined') return;
        const adjacent = window.articlesData.getAdjacentArticles(articleId);
        let html = '';
        if (adjacent.prev) {
            html += `<a href="/blog/${adjacent.prev.fileName}" class="nav-btn prev"><i class="fas fa-chevron-left"></i><div><div style="font-size:0.8rem;opacity:0.8;">上一篇</div><div>${adjacent.prev.title}</div></div></a>`;
        } else {
            html += `<a href="javascript:void(0)" class="nav-btn prev disabled"><i class="fas fa-chevron-left"></i><div><div style="font-size:0.8rem;opacity:0.8;">上一篇</div><div>已是第一篇</div></div></a>`;
        }
        if (adjacent.next) {
            html += `<a href="/blog/${adjacent.next.fileName}" class="nav-btn next"><div><div style="font-size:0.8rem;opacity:0.8;">下一篇</div><div>${adjacent.next.title}</div></div><i class="fas fa-chevron-right"></i></a>`;
        } else {
            html += `<a href="javascript:void(0)" class="nav-btn next disabled"><div><div style="font-size:0.8rem;opacity:0.8;">下一篇</div><div>已是最后一篇</div></div><i class="fas fa-chevron-right"></i></a>`;
        }
        navigation.innerHTML = html;
    }

    function initRelatedArticles(articleId) {
        const grid = document.getElementById('relatedGrid');
        if (!grid || typeof window.articlesData === 'undefined') return;
        const related = window.articlesData.getFeaturedArticles(articleId, 3);
        grid.innerHTML = '';
        related.forEach(article => {
            const card = document.createElement('a');
            card.href = '/blog/' + article.fileName + '?blog=' + article.id;
            card.className = 'related-card';
            card.innerHTML = `<h4>${article.title}</h4><p>${article.excerpt}</p><div class="related-tags">${article.tags.slice(0, 3).map(t => `<span class="related-tag">${t}</span>`).join('')}</div>`;
            grid.appendChild(card);
        });
    }

    function initShareFunction() {
        const shareButton = document.getElementById('shareButton');
        const shareModal = document.getElementById('shareModal');
        const shareText = document.getElementById('shareText');
        const copyBtn = document.getElementById('copyShareText');
        const closeBtn1 = document.getElementById('closeShareModal');
        const closeBtn2 = document.getElementById('closeShareModalBtn');
        if (!shareButton || !shareModal) return;
        const articleTitle = document.getElementById('articleTitle').textContent;
        const shareUrl = `https://91vip.xn--32v.ink/blog/18/`;
        const shareMessage = `快来看看这篇文章《${articleTitle}》: ${shareUrl}`;
        shareText.textContent = shareMessage;
        shareButton.addEventListener('click', () => shareModal.classList.add('active'));
        function close() { shareModal.classList.remove('active'); copyBtn.innerHTML = '<i class="far fa-copy"></i> 复制分享链接'; copyBtn.classList.remove('copied'); }
        closeBtn1.addEventListener('click', close);
        closeBtn2.addEventListener('click', close);
        shareModal.addEventListener('click', e => { if (e.target === shareModal) close(); });
        copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(shareMessage).then(() => {
                copyBtn.innerHTML = '<i class="fas fa-check"></i> 已复制到剪贴板';
                copyBtn.classList.add('copied');
                setTimeout(() => { copyBtn.innerHTML = '<i class="far fa-copy"></i> 复制分享链接'; copyBtn.classList.remove('copied'); }, 3000);
            }).catch(() => alert('复制失败，请手动复制'));
        });
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && shareModal.classList.contains('active')) close(); });
    }

    function addReadingProgressBar() {
        if (document.getElementById('reading-progress-bar')) return;
        const bar = document.createElement('div');
        bar.id = 'reading-progress-bar';
        bar.style.cssText = 'position:fixed;top:0;left:0;height:3px;background:linear-gradient(135deg,var(--bili-pink),var(--bili-blue));width:0%;z-index:9999;transition:width 0.1s ease;';
        document.body.appendChild(bar);
        window.addEventListener('scroll', () => {
            const d = document.documentElement.scrollHeight - window.innerHeight;
            if (d > 0) bar.style.width = (window.pageYOffset / d * 100) + '%';
        }, { passive: true });
    }

    function initPage() {
        if (typeof window.articlesData === 'undefined') { setTimeout(initPage, 100); return; }
        initArticleNavigation(currentArticleId);
        initRelatedArticles(currentArticleId);
        initShareFunction();
        addReadingProgressBar();
    }

    initPage();
});
    </script>
<script>
(function(){
    var blogId = new URLSearchParams(window.location.search).get("blog");
    if (blogId) {
        console.log("文章 ID:", blogId);
    }
})();
</script>
