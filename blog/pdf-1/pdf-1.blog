[Title] 《发呆改变世界》沃玛 - ciallo0721-cmd
[Date] 2026-06-15
[Author] ciallo0721-cmd
[Tag] 文章

[正文开始]

[HTML]
<div class="container">

        <!-- PDF 阅读器 -->
        <div class="pdf-reader-wrap">
            <!-- 工具栏 -->
            <div class="pdf-reader-toolbar">
                <label class="pdf-upload-label">
                    <i class="fas fa-folder-open"></i> 打开本地 PDF
                    <input type="file" id="pdfFileInput" accept=".pdf,application/pdf">
                </label>

                <div class="pdf-url-row">
                    <input type="text" class="pdf-url-input" id="pdfUrlInput" placeholder="粘贴 PDF URL 加载（需 CORS）">
                    <button class="pdf-url-btn" id="pdfUrlBtn"><i class="fas fa-download"></i> 加载</button>
                </div>

                <div class="pdf-page-ctrl">
                    <button class="pdf-page-btn" id="pdfPrev" disabled title="上一页"><i class="fas fa-chevron-left"></i></button>
                    <span id="pdfPageInfo" style="white-space:nowrap;min-width:70px;text-align:center;">— / —</span>
                    <button class="pdf-page-btn" id="pdfNext" disabled title="下一页"><i class="fas fa-chevron-right"></i></button>
                </div>

                <button class="pdf-zoom-btn" id="pdfZoomOut" title="缩小"><i class="fas fa-search-minus"></i></button>
                <span id="pdfZoomLabel" style="font-size:0.82rem;color:var(--text-secondary);white-space:nowrap;min-width:38px;text-align:center;">100%</span>
                <button class="pdf-zoom-btn" id="pdfZoomIn" title="放大"><i class="fas fa-search-plus"></i></button>
                <button class="pdf-fit-btn" id="pdfFitBtn" title="适应宽度"><i class="fas fa-expand-arrows-alt"></i> 适宽</button>
            </div>

            <!-- 画布 -->
            <div class="pdf-canvas-area" id="pdfArea" tabindex="0">
                <div class="pdf-placeholder" id="pdfPlaceholder">
                    <i class="fas fa-file-pdf"></i>
                    <p>正在加载《发呆改变世界》……</p>
                </div>
                <div class="pdf-loading" id="pdfLoading"><i class="fas fa-circle-notch"></i> 渲染中...</div>
                <canvas id="pdfCanvas" style="display:none;"></canvas>
            </div>

            <!-- 状态栏 -->
            <div class="pdf-status-bar">
                <span id="pdfFileName">warma.pdf</span>
                <span id="pdfErr" class="pdf-err"></span>
            </div>
        </div>

    </div>
</div>

<!-- 页脚 -->
<footer>
    <div class="container">
        <p>© 2025 ciallo0721-cmd &nbsp;·&nbsp;
           <a href="../../index.html">主页</a> &nbsp;·&nbsp;
           <a href="../../wz.html">文章</a>
        </p>
    </div>
</footer>

<script>
(function () {
    if (!window.pdfjsLib) {
        document.getElementById('pdfErr').textContent = 'PDF.js 未加载，请刷新重试';
        return;
    }
    pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    var pdfDoc = null, curPage = 1, totalPages = 0, scale = 1.2;
    var renderTask = null;
    var canvas = document.getElementById('pdfCanvas');
    var ctx = canvas.getContext('2d');

    function $(id) { return document.getElementById(id); }
    function setErr(msg) { $('pdfErr').textContent = msg || ''; }
    function showLoading(v) { $('pdfLoading').style.display = v ? 'block' : 'none'; }

    function updateUI() {
        $('pdfPageInfo').textContent = totalPages ? curPage + ' / ' + totalPages : '— / —';
        $('pdfPrev').disabled = curPage <= 1;
        $('pdfNext').disabled = curPage >= totalPages;
        $('pdfZoomLabel').textContent = Math.round(scale * 100) + '%';
    }

    function renderPage(num) {
        if (!pdfDoc) return;
        showLoading(true);
        canvas.style.display = 'none';
        if (renderTask) { renderTask.cancel(); }
        pdfDoc.getPage(num).then(function (page) {
            // 适应宽度模式下自动计算 scale
            var areaW = $('pdfArea').clientWidth - 40;
            var vp0 = page.getViewport({ scale: 1 });
            var autoScale = areaW / vp0.width;
            var useScale = (fitMode && autoScale > 0) ? autoScale : scale;
            var viewport = page.getViewport({ scale: useScale });
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            renderTask = page.render({ canvasContext: ctx, viewport: viewport });
            return renderTask.promise;
        }).then(function () {
            curPage = num;
            canvas.style.display = 'block';
            showLoading(false);
            setErr('');
            updateUI();
        }).catch(function (e) {
            if (e && e.name === 'RenderingCancelledException') return;
            showLoading(false);
            setErr('渲染失败：' + (e && e.message || e));
        });
    }

    var fitMode = false;

    function loadPDF(src, name) {
        setErr('');
        $('pdfPlaceholder').style.display = 'none';
        canvas.style.display = 'none';
        showLoading(true);
        if (name) $('pdfFileName').textContent = name;
        var task = pdfjsLib.getDocument(src);
        task.promise.then(function (doc) {
            pdfDoc = doc;
            totalPages = doc.numPages;
            curPage = 1;
            renderPage(1);
        }).catch(function (e) {
            showLoading(false);
            $('pdfPlaceholder').style.display = '';
            $('pdfPlaceholder').querySelector('p').textContent = '加载失败，请检查网络或文件';
            setErr('错误：' + (e && e.message || e));
        });
    }

    // 自动加载 warma.pdf
    // file:// 协议下 fetch 会被拦截，部署到 HTTP 服务后正常工作
    // 先尝试 fetch，失败则提示用户手动上传
    (function autoLoad() {
        var isFileProto = location.protocol === 'file:';
        if (isFileProto) {
            // file:// 协议：直接提示，不尝试 fetch（会报 Missing PDF 错误）
            $('pdfPlaceholder').style.display = '';
            $('pdfPlaceholder').querySelector('p').innerHTML =
                '⚠️ 本地预览模式下无法自动加载 PDF。<br>' +
                '请点击「打开本地 PDF」上传 <b>warma.pdf</b><br>' +
                '<small style="color:#aaa">部署到 GitHub Pages 后可自动加载</small>';
            showLoading(false);
            return;
        }
        // HTTP 模式：正常加载
        loadPDF('./warma.pdf', '《发呆改变世界》沃玛.pdf');
    })();

    // 上传本地文件
    $('pdfFileInput').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (ev) {
            loadPDF({ data: new Uint8Array(ev.target.result) }, file.name);
        };
        reader.readAsArrayBuffer(file);
        fitMode = false;
    });

    // URL 加载
    $('pdfUrlBtn').addEventListener('click', function () {
        var url = $('pdfUrlInput').value.trim();
        if (!url) return;
        loadPDF(url, url);
        fitMode = false;
    });
    $('pdfUrlInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') $('pdfUrlBtn').click();
    });

    // 翻页
    $('pdfPrev').addEventListener('click', function () { if (curPage > 1) renderPage(curPage - 1); });
    $('pdfNext').addEventListener('click', function () { if (curPage < totalPages) renderPage(curPage + 1); });

    // 缩放
    $('pdfZoomIn').addEventListener('click', function () {
        fitMode = false;
        if (scale >= 4.0) return;
        scale = Math.round((scale + 0.25) * 100) / 100;
        renderPage(curPage);
    });
    $('pdfZoomOut').addEventListener('click', function () {
        fitMode = false;
        if (scale <= 0.5) return;
        scale = Math.round((scale - 0.25) * 100) / 100;
        renderPage(curPage);
    });

    // 适宽
    $('pdfFitBtn').addEventListener('click', function () {
        fitMode = !fitMode;
        $('pdfFitBtn').style.background = fitMode ? 'var(--bili-blue)' : '';
        $('pdfFitBtn').style.color = fitMode ? 'white' : '';
        renderPage(curPage);
    });

    // 键盘翻页
    $('pdfArea').addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); if (curPage > 1) renderPage(curPage - 1); }
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); if (curPage < totalPages) renderPage(curPage + 1); }
    });

    // 窗口 resize 时重绘（适宽模式）
    var resizeTimer;
    window.addEventListener('resize', function () {
        if (!fitMode) return;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () { renderPage(curPage); }, 200);
    });

    updateUI();
})();
</script>
[/html]
