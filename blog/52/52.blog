[Title] 加载中...
[Date] 2026-06-15
[Author] ciallo0721-cmd
[Tag] 文章

[正文开始]

[HTML]
<div id="loader"><div class="spinner"></div><p>正在加载 NextScript 文章...</p></div>
<div id="app" style="display:none;">
  <div id="header"></div>
  <div id="hero"></div>
  <div id="content" class="article-body"></div>
  <div id="footer" class="article-footer"></div>
</div>
<div id="error" style="display:none;"></div>

<script>
// ============================================================
// NextScript v1 解码器（修复版）
// ============================================================

const NS = (function() {
  // 工具函数
  const escapeHtml = function(s) {
    if (!s) return '';
    return s.replace(/&/g, '&amp;')
           .replace(/</g, '&lt;')
           .replace(/>/g, '&gt;');
  };
  
  // 行内格式解析（**粗体** *斜体* __下划线__ ~~删除线~~ `代码` [链接](url) ![图片](url)）
  const parseInline = function(text) {
    if (!text) return '';
    var result = text;
    // 粗体
    result = result.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // 斜体
    result = result.replace(/\*(.+?)\*/g, '<em>$1</em>');
    // 下划线
    result = result.replace(/__(.+?)__/g, '<u>$1</u>');
    // 删除线
    result = result.replace(/~~(.+?)~~/g, '<del>$1</del>');
    // 行内代码
    result = result.replace(/`(.+?)`/g, '<code>$1</code>');
    // 链接 [文字](url)
    result = result.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="color:var(--primary)">$1</a>');
    // 图片 ![alt](url)
    result = result.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" style="max-width:100%;border-radius:8px;margin:16px 0">');
    return result;
  };

  // 渲染单个区块
  const renderBlock = function(block) {
    if (!block || !block.type) return '';
    var t = block.type;
    var text = parseInline(block.text || '');
    
    // 标题
    if (t === 'h1' || t === 'h2' || t === 'h3' || t === 'h4' || t === 'h5' || t === 'h6') {
      var id = block.id ? ' id="' + block.id + '"' : '';
      return '<' + t + id + '>' + text + '</' + t + '>';
    }
    
    // 段落
    if (t === 'p') {
      var cls = block['class'] ? ' class="' + block['class'] + '"' : '';
      return '<p' + cls + '>' + text + '</p>';
    }
    
    // 引用
    if (t === 'quote') {
      var src = block.source ? '<br><em>— ' + escapeHtml(block.source) + '</em>' : '';
      return '<blockquote>' + text + src + '</blockquote>';
    }
    
    // 行内代码
    if (t === 'inline-code') {
      return '<code>' + escapeHtml(block.text || '') + '</code>';
    }
    
    // 链接
    if (t === 'link') {
      return '<a href="' + (block.href || '#') + '" style="color:var(--primary)">' + escapeHtml(block.text || '') + '</a>';
    }
    
    // 图片
    if (t === 'img' || t === 'image') {
      return '<img src="' + (block.src || '') + '" alt="' + (block.alt || '') + '" />';
    }
    
    // 分隔线
    if (t === 'hr') return '<hr>';
    
    // 代码块
    if (t === 'code') {
      var lang = block.lang || '';
      var title = block.title || '';
      var header = title ? '<div class="code-header"><span>' + escapeHtml(title) + '</span><span>' + lang + '</span></div>' : '';
      var codeText = escapeHtml(block.text || '');
      return '<div class="code-block">' + header + '<pre><code class="lang-' + lang + '">' + codeText + '</code></pre></div>';
    }
    
    // 无序列表
    if (t === 'ul' && block.items) {
      var lis = block.items.map(function(it) { return '<li>' + parseInline(it) + '</li>'; }).join('');
      return '<ul>' + lis + '</ul>';
    }
    
    // 有序列表
    if (t === 'ol' && block.items) {
      var lis = block.items.map(function(it) { return '<li>' + parseInline(it) + '</li>'; }).join('');
      return '<ol>' + lis + '</ol>';
    }
    
    // 描述列表
    if (t === 'dl' && block.items) {
      var dts = block.items.map(function(it) { return '<dt>' + escapeHtml(it.term || '') + '</dt><dd>' + parseInline(it.desc || '') + '</dd>'; }).join('');
      return '<dl>' + dts + '</dl>';
    }
    
    // 提示框
    if (t === 'alert') {
      var at = (block['alert-type'] || 'tip').toLowerCase();
      var title = block.title || '';
      var titleHtml = title ? '<div class="alert-title">' + escapeHtml(title) + '</div>' : '';
      return '<div class="alert ' + at + '">' + titleHtml + '<div>' + parseInline(block.text || '') + '</div></div>';
    }
    
    // 按钮
    if (t === 'button' || t === 'btn') {
      var bt = (block['button-type'] || 'primary').toLowerCase();
      var href = block.href || block.to || '#';
      var cls = 'btn ' + bt;
      var content = parseInline(block.text || '');
      if (href && href !== '#') {
        return '<a href="' + href + '" class="' + cls + '">' + content + '</a>';
      }
      return '<button class="' + cls + '">' + content + '</button>';
    }
    
    // 徽章
    if (t === 'badge') {
      var bt = (block['badge-type'] || 'info').toLowerCase();
      return '<span class="badge ' + bt + '">' + parseInline(block.text || '') + '</span>';
    }
    
    // 卡片
    if (t === 'card') {
      var hover = block.hover ? ' hover' : '';
      var inner = (block.blocks || []).map(renderBlock).join('');
      return '<div class="card' + hover + '">' + inner + '</div>';
    }
    
    // 折叠
    if (t === 'collapse') {
      var title = block.title || '展开';
      var inner = (block.blocks || []).map(renderBlock).join('');
      return '<details><summary>' + escapeHtml(title) + '</summary><div>' + inner + '</div></details>';
    }
    
    // 进度条
    if (t === 'progress') {
      var val = parseFloat(block.value) || 0;
      var max = parseFloat(block.max) || 100;
      var pct = Math.round(val / max * 100);
      return '<div class="progress-bar"><div class="fill" style="width:' + pct + '%"></div></div>';
    }
    
    // 网格布局
    if (t === 'grid') {
      var cols = parseInt(block.cols) || 2;
      var gap = parseInt(block.gap) || 20;
      var cells = (block.cells || []).map(function(cellBlocks) {
        return '<div>' + (cellBlocks || []).map(renderBlock).join('') + '</div>';
      }).join('');
      return '<div class="grid cols-' + Math.min(cols, 3) + '" style="gap:' + gap + 'px">' + cells + '</div>';
    }
    
    // 弹性布局
    if (t === 'flex') {
      var dir = block.direction || 'row';
      var gap = parseInt(block.gap) || 12;
      var wrap = block.wrap ? 'flex-wrap:wrap;' : '';
      var items = (block.items || []).map(renderBlock).join('');
      return '<div style="display:flex;flex-direction:' + dir + ';gap:' + gap + 'px;' + wrap + '">' + items + '</div>';
    }
    
    // 居中
    if (t === 'center') {
      var inner = (block.blocks || []).map(renderBlock).join('');
      return '<div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px">' + inner + '</div>';
    }
    
    // 统计数字
    if (t === 'stat') {
      var val = block.value || '0';
      var label = block.label || '';
      var prefix = block.prefix || '';
      var suffix = block.suffix || '';
      return '<div class="stat-item"><div class="stat-value">' + prefix + val + suffix + '</div><div class="stat-label">' + label + '</div></div>';
    }
    
    // 时间线
    if (t === 'timeline') {
      var items = (block.items || []).map(function(it) {
        return '<div class="timeline-item"><strong>' + escapeHtml(it.date || '') + '</strong> ' + parseInline(it.text || '') + '</div>';
      }).join('');
      return '<div class="timeline">' + items + '</div>';
    }
    
    // 手风琴
    if (t === 'accordion') {
      var panes = (block.panes || []).map(function(p) {
        var title = p.title || '项';
        var text = parseInline(p.text || '');
        return '<div class="accordion-pane"><div class="accordion-header" onclick="this.parentElement.classList.toggle(\'open\')">' + escapeHtml(title) + ' <span>▼</span></div><div class="accordion-body">' + text + '</div></div>';
      }).join('');
      return '<div class="accordion">' + panes + '</div>';
    }
    
    // 分节
    if (t === 'section') {
      var id = block.id ? ' id="' + block.id + '"' : '';
      var inner = (block.blocks || []).map(renderBlock).join('');
      return '<section' + id + '>' + inner + '</section>';
    }
    
    // 默认
    return '<div class="ns-' + t + '">' + parseInline(block.text || '') + '</div>';
  };

  // 主函数：加载并渲染
  const loadAndRender = async function(articleId) {
    var url = './' + articleId + '.blog';
    var resp = await fetch(url);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    var yamlText = await resp.text();
    
    // 用 js-yaml 解析
    var data = window.jsyaml.load(yamlText);
    if (!data || !data.meta || !data.body) throw new Error('无效的 NextScript 文件格式');
    
    var meta = data.meta;
    var body = data.body;
    
    // 设置标题
    if (meta.title) {
      document.title = meta.title;
      var headerEl = document.getElementById('header');
      if (headerEl) {
        var tagsHtml = '';
        if (meta.tags && meta.tags.length > 0) {
          tagsHtml = '<div class="article-tags">' + meta.tags.map(function(t) { return '<span class="tag">' + escapeHtml(t) + '</span>'; }).join('') + '</div>';
        }
        headerEl.innerHTML = '<div class="article-header"><h1>' + escapeHtml(meta.title) + '</h1><div class="article-meta">' + (meta.author ? '<span>✍️ ' + escapeHtml(meta.author) + '</span>' : '') + (meta.date ? '<span>📅 ' + escapeHtml(meta.date) + '</span>' : '') + '</div>' + tagsHtml + '</div>';
      }
    }
    
    // 主题
    if (meta.theme === 'light') {
      document.documentElement.style.setProperty('--bg', '#ffffff');
      document.documentElement.style.setProperty('--bg2', '#f6f8fa');
      document.documentElement.style.setProperty('--bg3', '#eaeef2');
      document.documentElement.style.setProperty('--text', '#1f2328');
      document.documentElement.style.setProperty('--text2', '#656d76');
      document.documentElement.style.setProperty('--border', '#d0d7de');
    }
    
    // 分离 hero / content / footer
    var heroHtml = '';
    var contentHtml = '';
    var footerHtml = '';
    
    for (var i = 0; i < body.length; i++) {
      var block = body[i];
      if (block.type === 'section' && block.id === 'hero') {
        heroHtml = renderBlock(block);
      } else if (block.type === 'section' && block.id === 'footer') {
        footerHtml = renderBlock(block);
      } else {
        contentHtml += renderBlock(block);
      }
    }
    
    // 写入 DOM
    if (heroHtml) {
      document.getElementById('hero').innerHTML = heroHtml;
    } else {
      document.getElementById('hero').style.display = 'none';
    }
    
    document.getElementById('content').innerHTML = '<a href="/wz.html" class="back-link">← 返回文章列表</a>' + contentHtml;
    
    if (footerHtml) {
      document.getElementById('footer').innerHTML = footerHtml;
    } else {
      document.getElementById('footer').style.display = 'none';
    }
    
    return data;
  };

  return { loadAndRender: loadAndRender, renderBlock: renderBlock };
})();

// 主程序
(function() {
  var loader = document.getElementById('loader');
  var app = document.getElementById('app');
  var errorBox = document.getElementById('error');
  
  function getArticleId() {
    var path = window.location.pathname;
    var match = path.match(/\/blog\/(\d+)/);
    return match ? match[1] : null;
  }
  
  var articleId = getArticleId();
  if (!articleId) {
    loader.style.display = 'none';
    errorBox.style.display = 'block';
    errorBox.innerHTML = '<div id="error-box"><h2>😿 无法识别文章 ID</h2><p>请将文章放在 blog/{id}/ 文件夹下，并放置 {id}.blog 文件。</p><p style="margin-top:16px"><a href="/" style="color:var(--primary)">← 返回首页</a></p></div>';
    return;
  }
  
  NS.loadAndRender(articleId).then(function() {
    loader.style.display = 'none';
    app.style.display = 'block';
  }).catch(function(e) {
    loader.style.display = 'none';
    errorBox.style.display = 'block';
    errorBox.innerHTML = '<div id="error-box"><h2>😿 加载失败</h2><p>' + escapeHtml(e.message) + '</p><p style="margin-top:16px"><a href="/" style="color:var(--primary)">← 返回首页</a></p></div>';
  });
})();
</script>
[/html]
