/*
  # 防点击劫持：禁止本站被嵌入 iframe
  X-Frame-Options: SAMEORIGIN

  # 防 MIME 类型嗅探攻击
  X-Content-Type-Options: nosniff

  # 强制启用 XSS 过滤（旧浏览器兼容）
  X-XSS-Protection: 1; mode=block

  # 引用来源策略：仅发送 origin，不泄露完整 URL
  Referrer-Policy: strict-origin-when-cross-origin

  # 权限策略：禁用不必要的浏览器特性
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy (SEO-安全平衡版)
  # 说明：
  #   - default-src 'self'                                   默认仅允许同源资源
  #   - script-src 'self' 'unsafe-inline' 'unsafe-eval'      保留内联脚本和动态加载（decoder.js、GA 等需要）
  #   - style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com
  #   - font-src 'self' cdnjs.cloudflare.com data:
  #   - img-src 'self' data: blob:
  #   - media-src 'self'
  #   - frame-src 'self'
  #   - connect-src 'self' https://api.ip.sb                     允许同源 XHR + 访客追踪公网 IP 查询
  #   - object-src 'none'
  #   - base-uri 'self'
  #   - form-action 'self'
  #
  #   注意: 'unsafe-inline' 对 Googlebot 的渲染管线至关重要，因为 decoder 使用内联 JS 加载文章。
  #   如果没有 unsafe-inline，Googlebot 的 headless Chrome 将无法执行任何脚本，
  #   导致页面被判定为无内容（"Crawled but not indexed"）。
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com; font-src 'self' cdnjs.cloudflare.com data:; img-src 'self' data: blob:; media-src 'self'; frame-src 'self'; connect-src 'self' https://www.google-analytics.com https://api.ip.sb https://v1.hitokoto.cn; object-src 'none'; base-uri 'self'; form-action 'self';

  # 性能优化：缓存策略
  # 静态资源缓存1年
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 媒体文件
*.png, *.jpg, *.jpeg, *.gif, *.webp, *.svg, *.ico
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
*.woff, *.woff2, *.ttf, *.otf, *.eot
  Cache-Control: public, max-age=31536000, immutable

# 音频文件
*.mp3, *.ogg, *.wav, *.m4a
  Cache-Control: public, max-age=2592000

# HTML文件 - 不缓存，确保最新内容
*.html, *.htm
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 文本文件 - 短缓存，便于 IndexNow key 更新
*.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JSON文件
*.json
  Cache-Control: public, max-age=86400

# JavaScript文件 - 长期缓存
*.js
  Cache-Control: public, max-age=31536000, immutable

